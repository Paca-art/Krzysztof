    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // --- OBSŁUGA SCROLL SNAPPING I ANIMACJI WEJŚCIA ---
            const observerOptions = {
                root: document.querySelector('.snap-container'),
                rootMargin: '0px',
                threshold: 0.35 
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        
                        const skillBars = entry.target.querySelectorAll('.skill-bar');
                        skillBars.forEach(bar => {
                            const targetWidth = bar.getAttribute('data-width');
                            setTimeout(() => {
                                bar.style.width = targetWidth;
                            }, 50); 
                        });

                        // --- LOGIKA EASTER EGG ---
                        if (entry.target.id === 'skills') {
                            const easterEgg = document.getElementById('easter-egg');
                            if (easterEgg && !easterEgg.classList.contains('peeked')) {
                                easterEgg.classList.add('peeked');
                                
                                // Powolne i płynne wysunięcie zza ekranu
                                easterEgg.style.transition = 'transform 1.5s cubic-bezier(0.16, 1, 0.3, 1)';
                                easterEgg.style.transform = 'translate(0, -50%)';
                                
                                // Po pełnym wysunięciu czeka 1 sekundę i szybko ucieka
                                setTimeout(() => {
                                    easterEgg.style.transition = 'transform 0.3s ease-in';
                                    easterEgg.style.transform = 'translate(-100%, -50%)';
                                }, 1500 + 1000); // 1.5s animacji wejścia + 1s pauzy
                            }
                        }

                    } else {
                        entry.target.classList.remove('is-visible');
                        const skillBars = entry.target.querySelectorAll('.skill-bar');
                        skillBars.forEach(bar => {
                            bar.style.width = '0';
                        });

                        // Reset Easter Egga, żeby zadziałał ponownie przy kolejnym przewinięciu
                        if (entry.target.id === 'skills') {
                            const easterEgg = document.getElementById('easter-egg');
                            if (easterEgg) {
                                easterEgg.classList.remove('peeked');
                                easterEgg.style.transition = 'none'; // Resetujemy bez animacji
                                easterEgg.style.transform = 'translate(-100%, -50%)';
                            }
                        }
                    }
                });
            }, observerOptions);

            document.querySelectorAll('.snap-section').forEach(section => {
                observer.observe(section);
            });

            // --- ANIMACJA METABALLS (HERO SECTION) ---
            const canvas = document.getElementById('blob-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const mainCircle = document.querySelector('.main-circle');
            let width, height;
            let mouse = { x: undefined, y: undefined };

            const colors = ['#0052FF'];

            class Particle {
                constructor(baseAngle, orbitRadius, radius, side) {
                    this.baseAngle = baseAngle; // Domyślna pozycja na orbicie (kąt)
                    this.currentAngle = baseAngle;
                    this.baseOrbitRadius = orbitRadius; // Domyślna odległość od środka
                    this.currentOrbitRadius = orbitRadius;
                    this.radius = radius;
                    this.side = side;
                    this.color = colors[0];

                    // Ruch po łuku (orbitowanie przód-tył)
                    this.arcSpeed = (Math.random() * 0.008 + 0.004) * (Math.random() > 0.5 ? 1 : -1);
                    this.arcTime = Math.random() * Math.PI * 2;
                    this.arcAmplitude = Math.random() * 0.4 + 0.2; // Rozpiętość ruchu po orbicie

                    // Ruch do środka i na zewnątrz (odpowiada za rzadsze stykanie się)
                    this.radialSpeed = Math.random() * 0.015 + 0.008;
                    this.radialTime = Math.random() * Math.PI * 2;
                    this.radialAmplitude = Math.random() * 25 + 15; // Zmiana odległości
                }

                draw() {
                    ctx.beginPath();
                    ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                    ctx.fillStyle = this.color;
                    ctx.fill();
                }

                update(mainCX, mainCY) {
                    this.arcTime += this.arcSpeed;
                    this.radialTime += this.radialSpeed;

                    // Wyliczanie idealnej pozycji na dany moment
                    let targetAngle = this.baseAngle + Math.sin(this.arcTime) * this.arcAmplitude;
                    let targetRadius = this.baseOrbitRadius + Math.sin(this.radialTime) * this.radialAmplitude;

                    // --- INTERAKCJA Z MYSZKĄ (Odepchnięcie) ---
                    if (mouse.x !== undefined && mouse.y !== undefined) {
                        let tempX = mainCX + Math.cos(this.currentAngle) * this.currentOrbitRadius;
                        let tempY = mainCY + Math.sin(this.currentAngle) * this.currentOrbitRadius;
                        let dx = mouse.x - tempX;
                        let dy = mouse.y - tempY;
                        let distance = Math.sqrt(dx * dx + dy * dy);
                        let interactionRadius = 130;

                        if (distance < interactionRadius) {
                            let force = (interactionRadius - distance) / interactionRadius;
                            targetRadius += force * 60; // Mocne odepchnięcie na zewnątrz
                            
                            // Delikatne przesunięcie po łuku uciekające przed myszką
                            let mouseAngle = Math.atan2(mouse.y - mainCY, mouse.x - mainCX);
                            let angleDiff = targetAngle - mouseAngle;
                            
                            // Normalizacja kąta
                            while (angleDiff > Math.PI) angleDiff -= Math.PI * 2;
                            while (angleDiff < -Math.PI) angleDiff += Math.PI * 2;
                            
                            targetAngle += Math.sign(angleDiff) * force * 0.4;
                        }
                    }

                    // Płynne przejście do wyliczonej pozycji (Interpolacja)
                    this.currentAngle += (targetAngle - this.currentAngle) * 0.04;
                    this.currentOrbitRadius += (targetRadius - this.currentOrbitRadius) * 0.04;

                    this.x = mainCX + Math.cos(this.currentAngle) * this.currentOrbitRadius;
                    this.y = mainCY + Math.sin(this.currentAngle) * this.currentOrbitRadius;
                    
                    this.draw();
                }
            }

            let particles = [];
            function init() {
                width = canvas.width = canvas.parentElement.offsetWidth;
                height = canvas.height = canvas.parentElement.offsetHeight;
                particles = [];

                const mainCircleRect = mainCircle.getBoundingClientRect();
                const canvasRect = canvas.getBoundingClientRect();
                const mainCX = mainCircleRect.left - canvasRect.left + mainCircleRect.width / 2;
                const mainCY = mainCircleRect.top - canvasRect.top + mainCircleRect.height / 2;
                
                const mainRadius = mainCircleRect.width / 2; // Główny promień (ok. 190px)

                // 3 cząsteczki po LEWEJ stronie
                // Kąty wokół PI (180 stopni to lewa strona)
                let leftAngles = [Math.PI, Math.PI - 0.4, Math.PI + 0.5];
                for (let i = 0; i < 3; i++) {
                    let radius;
                    if (i === 0) { // Pierwsze kółko znacznie większe
                        radius = Math.random() * 20 + 40; // Zakres 40-60px
                    } else { // Pozostałe mniejsze
                        radius = Math.random() * 15 + 20; // Zakres 20-35px
                    }
                    // Domyślny promień orbity ustawiony tak, by tylko przy maksymalnym wychyleniu dotykały krawędzi
                    let baseOrbit = mainRadius + radius + 25; 
                    particles.push(new Particle(leftAngles[i], baseOrbit, radius, 'left'));
                }

                // 1 cząsteczka po PRAWEJ stronie
                let rightRadius = Math.random() * 20 + 25; // Większa średnica, zakres 25-45px
                let rightOrbit = mainRadius + rightRadius + 45; // Trzyma się znacznie dalej
                particles.push(new Particle(0.15, rightOrbit, rightRadius, 'right')); // Kąt blisko 0

                // Przekazanie środka głównego koła do canvasu
                canvas.mainCX = mainCX;
                canvas.mainCY = mainCY;
            }

            function animate() {
                requestAnimationFrame(animate);
                ctx.clearRect(0, 0, width, height);
                particles.forEach(particle => particle.update(canvas.mainCX, canvas.mainCY));
            }

            // Obsługa resize i myszki
            window.addEventListener('resize', init);
            canvas.addEventListener('mousemove', (e) => {
                const rect = canvas.getBoundingClientRect();
                mouse.x = e.clientX - rect.left;
                mouse.y = e.clientY - rect.top;
            });
            canvas.addEventListener('mouseleave', () => {
                mouse.x = undefined;
                mouse.y = undefined;
            });

            init();
            animate();
            // Zastosowanie filtra do kontenera
            canvas.parentElement.style.filter = "url('#gooey-filter')";
        });
    </script>
