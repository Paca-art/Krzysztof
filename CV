    <style>
        /* SCROLL SNAPPING */
        html, body {
            height: 100%;
            margin: 0;
            overflow-x: hidden;
        }
        
        .snap-container {
            height: 100vh;
            overflow-y: scroll;
            scroll-snap-type: y mandatory;
            scrollbar-width: none;
        }
        .snap-container::-webkit-scrollbar {
            display: none;
        }

        .snap-section {
            scroll-snap-align: start;
            height: 100vh;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
            width: 100%;
        }

        /* RESPONSYWNY KONTENER */
        .rigid-container {
            width: 100%;
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        @media (max-width: 1023px) {
            .snap-section {
                height: auto; 
                min-height: 100vh;
                padding: 100px 0;
            }
            .footer-section { height: auto !important; }
        }

        /* SYSTEM ANIMACJI WEJŚCIA */
        .anim-left {
            transform: translateX(-150px);
            opacity: 0;
            transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .anim-right {
            transform: translateX(150px);
            opacity: 0;
            transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .anim-bottom {
            transform: translateY(100px);
            opacity: 0;
            transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .is-visible .anim-left,
        .is-visible .anim-right,
        .is-visible .anim-bottom {
            transform: translate(0, 0);
            opacity: 1;
        }

        /* Opóźnienia */
        .delay-1 { transition-delay: 150ms; }
        .delay-2 { transition-delay: 300ms; }
        .delay-3 { transition-delay: 450ms; }

        /* Ukrywanie paska w karuzeli */
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { scrollbar-width: none; }

        /* Marquee */
        @keyframes marquee {
            0% { transform: translateX(0%); }
            100% { transform: translateX(-50%); }
        }
        .animate-marquee {
            display: flex;
            width: fit-content;
            animation: marquee 25s linear infinite;
        }

        .blob-bg {
            background: radial-gradient(circle, rgba(0,82,255,0.15) 0%, rgba(255,255,255,0) 70%);
        }

        /* ANIMACJA DELIKATNEJ GALARETY */
        @keyframes subtle-tremble {
            0% { border-radius: 50%; transform: scale(1); }
            25% { border-radius: 49% 51% 48% 52% / 51% 49% 52% 48%; transform: scale(0.99); }
            50% { border-radius: 51% 49% 52% 48% / 48% 52% 49% 51%; transform: scale(1.01); }
            75% { border-radius: 48% 52% 51% 49% / 52% 48% 50% 50%; transform: scale(0.995); }
            100% { border-radius: 50%; transform: scale(1); }
        }
        .animate-jelly {
            animation: subtle-tremble 4s infinite ease-in-out;
        }

        /* EASTER EGG STYLES */
        .easter-egg-container {
            position: fixed;
            top: 50%;
            left: 0;
            transform: translate(-100%, -50%); /* Domyślnie schowany za lewą krawędzią */
            z-index: 100;
            pointer-events: none; /* Żeby nie przeszkadzał w klikaniu */
            will-change: transform;
        }
        
        .easter-egg-image {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            border: 4px solid #0052FF;
            box-shadow: 0 10px 25px -5px rgba(0, 82, 255, 0.4);
            object-fit: cover;
            /* Ucięcie zdjęcia do połowy, żeby wyglądało jakby wyglądał zza krawędzi */
            clip-path: polygon(50% 0%, 100% 0%, 100% 100%, 50% 100%);
            transform: translateX(-50%); /* Przesunięcie, żeby widoczna była tylko prawa połówka */
        }
    </style>
